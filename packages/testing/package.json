{
  "name": "@sheavly/testing",
  "version": "0.0.0",
  "description": "Test fakes for every workspace: scripted providers, fake fetch, tool runners. Tests and fakes only.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "type": "module",
  "license": "UNLICENSED",
  "sheavly": {
    "domain": "generic",
    "testOnly": true
  },
  "exports": {
    "./*": {
      "@sheavly/source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "private": true,
  "dependencies": {
    "@sheavly/core": "^0.0.0",
    "@sheavly/protocol": "^0.0.0",
    "zod": "^4.6.7"
  }
}
