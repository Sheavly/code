NODE_ENV=development
LOG_LEVEL=info

# Which backend the demo (apps/terminal/src/demo.ts) uses: openai (default) or azure
# ADAPTER=openai

# Directory file tools are confined to (default: current directory)
# WORKSPACE_ROOT=

# Set to true to let run_command run ANY shell command (default: allow list only)
# RUN_COMMAND_SKIP_ALLOW_LIST=false

# OpenAI (default model gpt-6.1-sol)
OPENAI_API_KEY=
# MODEL=gpt-6.1-sol

# Azure OpenAI
AZURE_OPENAI_API_KEY=
# v1 style:    https://<resource>.openai.azure.com/openai/v1   (leave API_VERSION unset)
# dated style: https://<resource>.cognitiveservices.azure.com/openai  + API_VERSION
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_VERSION=
# Deployment name (defaults to gpt-6.1-sol)
# AZURE_OPENAI_DEPLOYMENT=gpt-6.1-sol
