{
  "name": "@sheavly/tools",
  "version": "0.0.0",
  "description": "The generic tools: sub-agents (start_agent, message_agent, report_status) and background task tools. No files, no commands.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "type": "module",
  "license": "UNLICENSED",
  "sheavly": {
    "domain": "generic"
  },
  "exports": {
    "./sub-agent/message-agent.tool": {
      "@sheavly/source": "./src/sub-agent/message-agent.tool.ts",
      "types": "./dist/sub-agent/message-agent.tool.d.ts",
      "default": "./dist/sub-agent/message-agent.tool.js"
    },
    "./sub-agent/sub-agent.tool": {
      "@sheavly/source": "./src/sub-agent/sub-agent.tool.ts",
      "types": "./dist/sub-agent/sub-agent.tool.d.ts",
      "default": "./dist/sub-agent/sub-agent.tool.js"
    },
    "./tasks/tasks.tool": {
      "@sheavly/source": "./src/tasks/tasks.tool.ts",
      "types": "./dist/tasks/tasks.tool.d.ts",
      "default": "./dist/tasks/tasks.tool.js"
    },
    "./sub-agent/report-status.tool": {
      "@sheavly/source": "./src/sub-agent/report-status.tool.ts",
      "types": "./dist/sub-agent/report-status.tool.d.ts",
      "default": "./dist/sub-agent/report-status.tool.js"
    }
  },
  "private": true,
  "dependencies": {
    "@sheavly/core": "^0.0.0",
    "@sheavly/protocol": "^0.0.0",
    "@sheavly/runtime": "^0.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sheavly/testing": "^0.0.0"
  }
}
