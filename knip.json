{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  // A type used in its own file's exported signatures (`Hook`'s `ToolCallContext`) is part of
  // that API: a hook or tool author names it, even if nothing in the repo does.
  "ignoreExportsUsedInFile": { "type": true },
  // A project hook's default export is what `loadProjectHooks` imports; nothing in the repo does.
  "ignoreIssues": { ".sheavly/hooks/*.mjs": ["exports"] },
  // `mkfifo` is a POSIX system tool, not a dependency: Node has no API to make a FIFO, and the
  // file-tool policy test needs one to prove a read refuses it instead of waiting for a writer.
  "ignoreBinaries": ["mkfifo"],
  "workspaces": {
    ".": {
      "entry": [
        ".cursor/hooks/*.mjs",
        "!.cursor/hooks/*.utils.mjs",
        ".sheavly/hooks/*.mjs",
        "!.sheavly/hooks/cursor-bridge.mjs"
      ],
      "ignore": ["workbook/workspaces/**"]
    },
    // The two-process lock test starts this file as a child process by path; nothing imports it.
    "packages/storage": { "entry": ["src/testing/lock-worker.fake.ts"] }
  }
}
