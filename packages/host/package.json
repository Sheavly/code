{
  "name": "@sheavly/host",
  "version": "0.0.0",
  "description": "Wires a run: createHarness, the registries and the generic tools, and the model from env. No UI and no project on disk.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "type": "module",
  "license": "UNLICENSED",
  "sheavly": {
    "domain": "generic"
  },
  "exports": {
    "./host/host.constants": {
      "@sheavly/source": "./src/host/host.constants.ts",
      "types": "./dist/host/host.constants.d.ts",
      "default": "./dist/host/host.constants.js"
    },
    "./host/host.helper": {
      "@sheavly/source": "./src/host/host.helper.ts",
      "types": "./dist/host/host.helper.d.ts",
      "default": "./dist/host/host.helper.js"
    },
    "./host/host.types": {
      "@sheavly/source": "./src/host/host.types.ts",
      "types": "./dist/host/host.types.d.ts",
      "default": "./dist/host/host.types.js"
    }
  },
  "private": true,
  "dependencies": {
    "@sheavly/core": "^0.0.0",
    "@sheavly/loop": "^0.0.0",
    "@sheavly/protocol": "^0.0.0",
    "@sheavly/providers": "^0.0.0",
    "@sheavly/runtime": "^0.0.0",
    "@sheavly/tools": "^0.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sheavly/testing": "^0.0.0"
  }
}
