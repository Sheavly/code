{
  // The published form: `dist/` for plain Node, built first by `tsc -b` (it depends on no other
  // workspace package). Tests stay out of it; dev and tests read `src/` through the
  // `@sheavly/source` condition instead (see `exports` in package.json).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // Resolve other workspace packages to their built `dist/`, never their source.
    "customConditions": []
  },
  "exclude": ["src/**/__tests__", "src/testing"]
}
