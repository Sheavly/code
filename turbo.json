{
  "$schema": "https://turborepo.com/schema.json",
  // The quality gate (`npm run check`), cached by inputs. Every workspace runs its own
  // `typecheck`, `lint` and `test`; each depends on the same task in the workspaces it imports
  // (`^`), so a change in a dependency reruns its dependents. The `//#` tasks are the root's:
  // `scripts/`, `.cursor/hooks/` and root configs, plus the repo-wide checks. The gate reads
  // source (the `@sheavly/source` condition); `build` (`npm run build`) is outside it.
  // The cache stays in this checkout (turbo would otherwise share the main worktree's), so a
  // worktree never writes into another one.
  "cacheDir": ".turbo/cache",
  // At most this many tasks run at once (turbo's default is 10). The tasks are typecheck, type-aware
  // lint and test runs, and each test run starts its own pool of workers (`maxWorkers` in
  // `vitest.config.ts`), so the two limits multiply: uncapped, the gate holds almost every core of
  // a 20-core machine for minutes. 5 with `maxWorkers` 4 was measured on that machine: the gate
  // used about 17% less CPU for the same work and almost never saturated it, while its wall time
  // stayed the same (the quality gate guide has the measurement). Override for one run with
  // `npm run check -- --concurrency=<n>`.
  "concurrency": "5",
  // A change in a shared config or the lockfile invalidates every cached result. The ESLint
  // config's own tests are left out: they change no rule, and the package's own `test` task still
  // hashes them. Its `testing/` fakes stay in, since the root's tests import them too.
  "globalDependencies": [
    "tsconfig.base.json",
    ".prettierrc.json",
    "vitest.config.ts",
    "package-lock.json",
    "packages/eslint-config/package.json",
    "packages/eslint-config/src/**",
    "!packages/eslint-config/src/**/__tests__/**"
  ],
  // Some tests make throwaway git repos and commits; CI gives them an identity.
  "globalPassThroughEnv": ["GIT_AUTHOR_*", "GIT_COMMITTER_*"],
  "tasks": {
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] },
    "lint": { "dependsOn": ["^lint"], "outputs": [] },
    "test": { "dependsOn": ["^test"], "outputs": [] },
    // Each workspace builds to its `dist/` after the workspaces it imports.
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },

    // The root's own files: `scripts/`, `.cursor/hooks/` and the root configs.
    "//#lint:root": { "outputs": [] },
    "//#test:root": { "outputs": [] },

    // Cross-workspace tool changes must always recheck the prompt review record, even when
    // affected-only filtering would not schedule host lint. Never restore a cached review.
    "//#lint:prompt": { "cache": false, "outputs": [] },

    // Repo-wide: every file counts. The root's `$TURBO_DEFAULT$` leaves the workspaces out, and
    // an explicit glob ignores .gitignore, so a workspace's tracked files are named: its top-level
    // files and `src/` (not its node_modules, dist or .turbo, which runs and builds write), for
    // packages/*, extensions/* and apps/* alike.
    "//#format:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "packages/*/*",
        "packages/*/src/**",
        "extensions/*/*",
        "extensions/*/src/**",
        "apps/*/*",
        "apps/*/src/**"
      ],
      "outputs": []
    },
    "//#knip": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "packages/*/*",
        "packages/*/src/**",
        "extensions/*/*",
        "extensions/*/src/**",
        "apps/*/*",
        "apps/*/src/**"
      ],
      "outputs": []
    },
    "//#jscpd": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "packages/*/*",
        "packages/*/src/**",
        "extensions/*/*",
        "extensions/*/src/**",
        "apps/*/*",
        "apps/*/src/**"
      ],
      "outputs": []
    },
    "//#layout": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "packages/*/*",
        "packages/*/src/**",
        "extensions/*/*",
        "extensions/*/src/**",
        "apps/*/*",
        "apps/*/src/**"
      ],
      "outputs": []
    }
  }
}
