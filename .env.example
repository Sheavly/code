NODE_ENV=development
LOG_LEVEL=info

# Which backend the demo (apps/terminal/src/demo.ts) uses: openai (default) or azure
# ADAPTER=openai

# Directory file tools are confined to (default: current directory)
# WORKSPACE_ROOT=

# Set to true to let run_command run ANY shell command (default: allow list only)
# RUN_COMMAND_SKIP_ALLOW_LIST=false

# OpenAI (default model gpt-6.1-sol)
OPENAI_API_KEY=
# MODEL=gpt-6.1-sol

# How a model call is sent: how long to wait for a response to start, and how many times to
# retry one that failed before anything streamed (first wait in ms, doubled each time).
# MODEL_RESPONSE_TIMEOUT_MS=60000
# MODEL_RETRIES=2
# MODEL_RETRY_DELAY_MS=1000

# Azure OpenAI
AZURE_OPENAI_API_KEY=
# v1 style:    https://<resource>.openai.azure.com/openai/v1   (leave API_VERSION unset)
# dated style: https://<resource>.cognitiveservices.azure.com/openai  + API_VERSION
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_VERSION=
# Deployment name (defaults to gpt-6.1-sol)
# AZURE_OPENAI_DEPLOYMENT=gpt-6.1-sol

# Several models on Azure, switched in the chat with /model <name> (the first starts active).
# Each name's keys are named after it (deepseek-flash -> DEEPSEEK_FLASH_*); with MODELS set,
# ADAPTER and its keys above are not read. See apps/terminal/docs/demo.md.
# MODELS=gpt,claude,deepseek-flash
#
# GPT on Azure OpenAI (the Responses API)
# GPT_ADAPTER=azure-openai
# GPT_API_KEY=
# GPT_BASE_URL=https://<resource>.openai.azure.com/openai/v1
# GPT_DEPLOYMENT=gpt-6.1-sol
#
# Claude on Azure AI Foundry (the Anthropic Messages API)
# CLAUDE_ADAPTER=azure-anthropic
# CLAUDE_API_KEY=
# CLAUDE_BASE_URL=https://<resource>.services.ai.azure.com/anthropic
# CLAUDE_DEPLOYMENT=
# CLAUDE_MAX_TOKENS=16000
# CLAUDE_THINKING_BUDGET=4096
#
# DeepSeek V4 Flash on Azure AI Foundry (the Responses API)
# DEEPSEEK_FLASH_ADAPTER=azure-openai
# DEEPSEEK_FLASH_API_KEY=
# DEEPSEEK_FLASH_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
# DEEPSEEK_FLASH_DEPLOYMENT=
# DEEPSEEK_FLASH_REASONING=false
