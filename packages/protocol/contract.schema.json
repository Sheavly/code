{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AgentEvent": {
      "allOf": [
        {
          "type": "object",
          "properties": { "seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } },
          "required": ["seq"]
        },
        { "$ref": "#/$defs/AgentEventBody" }
      ]
    },
    "AgentEventBody": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "text_delta" },
            "text": { "type": "string" }
          },
          "required": ["type", "text"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "reasoning" },
            "item": { "$ref": "#/$defs/ReasoningItem" }
          },
          "required": ["type", "item"]
        },
        {
          "type": "object",
          "properties": {
            "call": { "$ref": "#/$defs/ToolCall" },
            "description": { "type": "string" },
            "type": { "type": "string", "const": "tool_call_started" }
          },
          "required": ["call", "description", "type"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "turn_end" },
            "turn": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "stopReason": { "$ref": "#/$defs/TurnStopReason" }
          },
          "required": ["type", "turn", "stopReason"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "tool_batch" },
            "calls": { "type": "array", "items": { "$ref": "#/$defs/DescribedCall" } }
          },
          "required": ["type", "calls"]
        },
        {
          "type": "object",
          "properties": {
            "call": { "$ref": "#/$defs/ToolCall" },
            "description": { "type": "string" },
            "type": { "type": "string", "const": "tool_result" },
            "message": { "$ref": "#/$defs/Message" },
            "durationMs": { "type": "number" },
            "artifacts": {
              "readOnly": true,
              "type": "array",
              "items": { "$ref": "#/$defs/ToolArtifact" }
            }
          },
          "required": ["call", "description", "type", "message", "durationMs"]
        },
        {
          "type": "object",
          "properties": {
            "call": { "$ref": "#/$defs/ToolCall" },
            "description": { "type": "string" },
            "type": { "type": "string", "const": "task_running" },
            "task": { "$ref": "#/$defs/TaskInfo" },
            "message": { "$ref": "#/$defs/Message" },
            "durationMs": { "type": "number" }
          },
          "required": ["call", "description", "type", "task", "message", "durationMs"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "task_completed" },
            "task": { "$ref": "#/$defs/TaskInfo" }
          },
          "required": ["type", "task"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "message_received" },
            "message": { "$ref": "#/$defs/InboxMessage" }
          },
          "required": ["type", "message"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "context_added" },
            "hook": { "type": "string" },
            "content": { "type": "string" }
          },
          "required": ["type", "hook", "content"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "hook_failed" },
            "hook": { "type": "string" },
            "handler": { "type": "string" },
            "error": { "type": "string" }
          },
          "required": ["type", "hook", "handler", "error"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "done" },
            "reason": { "$ref": "#/$defs/DoneReason" },
            "session": { "$ref": "#/$defs/SessionRef" },
            "messages": { "type": "array", "items": { "$ref": "#/$defs/Message" } }
          },
          "required": ["type", "reason", "session", "messages"]
        }
      ]
    },
    "EntryEvent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "type": { "type": "string", "const": "text_delta" },
            "text": { "type": "string" }
          },
          "required": ["seq", "type", "text"]
        },
        {
          "type": "object",
          "properties": {
            "seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "type": { "type": "string", "const": "reasoning" },
            "item": { "$ref": "#/$defs/ReasoningItem" }
          },
          "required": ["seq", "type", "item"]
        },
        {
          "type": "object",
          "properties": {
            "seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "call": { "$ref": "#/$defs/ToolCall" },
            "description": { "type": "string" },
            "type": { "type": "string", "const": "tool_call_started" }
          },
          "required": ["seq", "call", "description", "type"]
        },
        {
          "type": "object",
          "properties": {
            "seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "type": { "type": "string", "const": "turn_end" },
            "turn": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "stopReason": { "$ref": "#/$defs/TurnStopReason" }
          },
          "required": ["seq", "type", "turn", "stopReason"]
        },
        {
          "type": "object",
          "properties": {
            "seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "type": { "type": "string", "const": "tool_batch" },
            "calls": { "type": "array", "items": { "$ref": "#/$defs/DescribedCall" } }
          },
          "required": ["seq", "type", "calls"]
        },
        {
          "type": "object",
          "properties": {
            "seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "call": { "$ref": "#/$defs/ToolCall" },
            "description": { "type": "string" },
            "type": { "type": "string", "const": "tool_result" },
            "message": { "$ref": "#/$defs/Message" },
            "durationMs": { "type": "number" },
            "artifacts": {
              "readOnly": true,
              "type": "array",
              "items": { "$ref": "#/$defs/ToolArtifact" }
            }
          },
          "required": ["seq", "call", "description", "type", "message", "durationMs"]
        },
        {
          "type": "object",
          "properties": {
            "seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "call": { "$ref": "#/$defs/ToolCall" },
            "description": { "type": "string" },
            "type": { "type": "string", "const": "task_running" },
            "task": { "$ref": "#/$defs/TaskInfo" },
            "message": { "$ref": "#/$defs/Message" },
            "durationMs": { "type": "number" }
          },
          "required": ["seq", "call", "description", "type", "task", "message", "durationMs"]
        },
        {
          "type": "object",
          "properties": {
            "seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "type": { "type": "string", "const": "task_completed" },
            "task": { "$ref": "#/$defs/TaskInfo" }
          },
          "required": ["seq", "type", "task"]
        },
        {
          "type": "object",
          "properties": {
            "seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "type": { "type": "string", "const": "message_received" },
            "message": { "$ref": "#/$defs/InboxMessage" }
          },
          "required": ["seq", "type", "message"]
        },
        {
          "type": "object",
          "properties": {
            "seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "type": { "type": "string", "const": "context_added" },
            "hook": { "type": "string" },
            "content": { "type": "string" }
          },
          "required": ["seq", "type", "hook", "content"]
        },
        {
          "type": "object",
          "properties": {
            "seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "type": { "type": "string", "const": "hook_failed" },
            "hook": { "type": "string" },
            "handler": { "type": "string" },
            "error": { "type": "string" }
          },
          "required": ["seq", "type", "hook", "handler", "error"]
        },
        {
          "type": "object",
          "properties": {
            "seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "type": { "type": "string", "const": "done" },
            "reason": { "$ref": "#/$defs/DoneReason" },
            "session": { "$ref": "#/$defs/SessionRef" }
          },
          "required": ["seq", "type", "reason", "session"]
        }
      ]
    },
    "DescribedCall": {
      "type": "object",
      "properties": { "call": { "$ref": "#/$defs/ToolCall" }, "description": { "type": "string" } },
      "required": ["call", "description"]
    },
    "DoneReason": { "type": "string", "enum": ["completed", "interrupted", "max_turns"] },
    "ToolArtifact": {
      "type": "object",
      "properties": { "kind": { "type": "string" } },
      "required": ["kind"],
      "additionalProperties": {}
    },
    "Message": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "role": { "type": "string", "const": "user" },
            "content": { "type": "string" },
            "parts": { "type": "array", "items": { "$ref": "#/$defs/PromptPart" } },
            "at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          },
          "required": ["role", "content"]
        },
        {
          "type": "object",
          "properties": {
            "role": { "type": "string", "const": "assistant" },
            "content": { "type": "string" },
            "toolCalls": { "type": "array", "items": { "$ref": "#/$defs/ToolCall" } },
            "reasoning": { "type": "array", "items": { "$ref": "#/$defs/ReasoningItem" } },
            "at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          },
          "required": ["role", "content", "toolCalls"]
        },
        {
          "type": "object",
          "properties": {
            "role": { "type": "string", "const": "tool" },
            "toolCallId": { "$ref": "#/$defs/CallId" },
            "content": { "type": "string" },
            "isError": { "type": "boolean" },
            "at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          },
          "required": ["role", "toolCallId", "content", "isError"]
        }
      ]
    },
    "PromptPart": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "text" },
            "text": { "type": "string" }
          },
          "required": ["type", "text"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "skill" },
            "name": { "$ref": "#/$defs/SkillName" }
          },
          "required": ["type", "name"]
        }
      ]
    },
    "ToolCall": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/CallId" },
        "name": { "type": "string" },
        "input": {}
      },
      "required": ["id", "name", "input"]
    },
    "ReasoningItem": {
      "type": "object",
      "properties": { "source": { "type": "string" }, "data": {} },
      "required": ["source", "data"]
    },
    "TurnStopReason": {
      "type": "string",
      "enum": ["end_turn", "tool_use", "max_tokens", "interrupted"]
    },
    "SessionRef": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": { "$ref": "#/$defs/SessionId" },
            "rootId": { "$ref": "#/$defs/SessionId" },
            "depth": { "type": "number", "const": 1 }
          },
          "required": ["id", "rootId", "depth"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": { "$ref": "#/$defs/SessionId" },
            "parentId": { "$ref": "#/$defs/SessionId" },
            "startedByCall": { "$ref": "#/$defs/CallId" },
            "rootId": { "$ref": "#/$defs/SessionId" },
            "depth": { "type": "integer", "minimum": 2, "maximum": 9007199254740991 }
          },
          "required": ["id", "parentId", "startedByCall", "rootId", "depth"]
        }
      ]
    },
    "SessionState": {
      "type": "string",
      "enum": ["running", "idle", "completed", "interrupted", "max_turns", "failed"]
    },
    "RunOutcome": { "type": "string", "enum": ["completed", "interrupted", "max_turns", "failed"] },
    "SessionInfo": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": { "$ref": "#/$defs/SessionId" },
            "rootId": { "$ref": "#/$defs/SessionId" },
            "depth": { "type": "number", "const": 1 },
            "title": { "type": "string" },
            "status": { "type": "string" },
            "state": { "$ref": "#/$defs/SessionState" },
            "lastOutcome": { "$ref": "#/$defs/RunOutcome" },
            "startedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "endedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "modelId": { "$ref": "#/$defs/ModelId" }
          },
          "required": ["id", "rootId", "depth", "title", "state", "startedAt"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": { "$ref": "#/$defs/SessionId" },
            "parentId": { "$ref": "#/$defs/SessionId" },
            "startedByCall": { "$ref": "#/$defs/CallId" },
            "rootId": { "$ref": "#/$defs/SessionId" },
            "depth": { "type": "integer", "minimum": 2, "maximum": 9007199254740991 },
            "title": { "type": "string" },
            "status": { "type": "string" },
            "state": { "$ref": "#/$defs/SessionState" },
            "lastOutcome": { "$ref": "#/$defs/RunOutcome" },
            "startedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "endedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "modelId": { "$ref": "#/$defs/ModelId" }
          },
          "required": [
            "id",
            "parentId",
            "startedByCall",
            "rootId",
            "depth",
            "title",
            "state",
            "startedAt"
          ]
        }
      ]
    },
    "InboxMessage": {
      "type": "object",
      "properties": {
        "from": {
          "anyOf": [{ "type": "string", "const": "user" }, { "$ref": "#/$defs/SessionId" }]
        },
        "content": { "type": "string" },
        "sentAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "required": ["from", "content", "sentAt"]
    },
    "SessionUpdate": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "session_started" },
            "session": { "$ref": "#/$defs/SessionInfo" }
          },
          "required": ["type", "session"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "session_status" },
            "session": { "$ref": "#/$defs/SessionInfo" }
          },
          "required": ["type", "session"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "session_message" },
            "session": { "$ref": "#/$defs/SessionInfo" },
            "message": { "$ref": "#/$defs/InboxMessage" }
          },
          "required": ["type", "session", "message"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "session_idle" },
            "session": { "$ref": "#/$defs/SessionInfo" }
          },
          "required": ["type", "session"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "session_resumed" },
            "session": { "$ref": "#/$defs/SessionInfo" }
          },
          "required": ["type", "session"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "session_model" },
            "session": { "$ref": "#/$defs/SessionInfo" },
            "modelId": { "$ref": "#/$defs/ModelId" }
          },
          "required": ["type", "session", "modelId"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "session_ended" },
            "session": { "$ref": "#/$defs/SessionInfo" }
          },
          "required": ["type", "session"]
        }
      ]
    },
    "StreamEntry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "sessionId": { "$ref": "#/$defs/SessionId" },
            "at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "kind": { "type": "string", "const": "event" },
            "event": { "$ref": "#/$defs/EntryEvent" }
          },
          "required": ["seq", "sessionId", "at", "kind", "event"]
        },
        {
          "type": "object",
          "properties": {
            "seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "sessionId": { "$ref": "#/$defs/SessionId" },
            "at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "kind": { "type": "string", "const": "update" },
            "update": { "$ref": "#/$defs/SessionUpdate" }
          },
          "required": ["seq", "sessionId", "at", "kind", "update"]
        },
        {
          "type": "object",
          "properties": {
            "seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "sessionId": { "$ref": "#/$defs/SessionId" },
            "at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "kind": { "type": "string", "const": "approval" },
            "update": { "$ref": "#/$defs/ApprovalUpdate" }
          },
          "required": ["seq", "sessionId", "at", "kind", "update"]
        },
        {
          "type": "object",
          "properties": {
            "seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "sessionId": { "$ref": "#/$defs/SessionId" },
            "at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "kind": { "type": "string", "const": "task" },
            "update": { "$ref": "#/$defs/TaskUpdate" }
          },
          "required": ["seq", "sessionId", "at", "kind", "update"]
        }
      ]
    },
    "TaskStatus": { "type": "string", "enum": ["running", "completed", "failed", "cancelled"] },
    "TaskInfo": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/TaskId" },
        "callId": { "$ref": "#/$defs/CallId" },
        "command": { "type": "string" },
        "description": { "type": "string" },
        "status": { "$ref": "#/$defs/TaskStatus" },
        "startedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "endedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "exitCode": {
          "anyOf": [
            { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "output": { "type": "string" },
        "error": { "type": "string" }
      },
      "required": ["id", "command", "description", "status", "startedAt", "output"]
    },
    "TaskUpdate": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "task_started" },
            "task": { "$ref": "#/$defs/TaskInfo" }
          },
          "required": ["type", "task"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "task_ended" },
            "task": { "$ref": "#/$defs/TaskInfo" }
          },
          "required": ["type", "task"]
        }
      ]
    },
    "ApprovalConcern": {
      "type": "object",
      "properties": { "argument": { "type": "string" }, "reason": { "type": "string" } },
      "required": ["argument", "reason"]
    },
    "ApprovalOption": { "type": "string", "enum": ["approve", "skip", "skip_with_message"] },
    "ApprovalRequest": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/ApprovalId" },
        "callId": { "$ref": "#/$defs/CallId" },
        "sessionId": { "$ref": "#/$defs/SessionId" },
        "tool": { "type": "string" },
        "command": { "type": "string" },
        "concerns": { "type": "array", "items": { "$ref": "#/$defs/ApprovalConcern" } },
        "options": {
          "readOnly": true,
          "type": "array",
          "items": { "$ref": "#/$defs/ApprovalOption" }
        }
      },
      "required": ["id", "callId", "tool", "command", "concerns", "options"]
    },
    "ApprovalResponse": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "decision": { "type": "string", "const": "approve" } },
          "required": ["decision"]
        },
        {
          "type": "object",
          "properties": { "decision": { "type": "string", "const": "skip" } },
          "required": ["decision"]
        },
        {
          "type": "object",
          "properties": {
            "decision": { "type": "string", "const": "skip_with_message" },
            "message": { "type": "string", "minLength": 1 }
          },
          "required": ["decision", "message"]
        }
      ]
    },
    "ApprovalUpdate": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "approval_requested" },
            "request": { "$ref": "#/$defs/ApprovalRequest" }
          },
          "required": ["type", "request"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "approval_resolved" },
            "id": { "$ref": "#/$defs/ApprovalId" },
            "response": { "$ref": "#/$defs/ApprovalResponse" }
          },
          "required": ["type", "id", "response"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "approval_cancelled" },
            "id": { "$ref": "#/$defs/ApprovalId" }
          },
          "required": ["type", "id"]
        }
      ]
    },
    "SkillName": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "SkillScope": { "type": "string", "enum": ["project", "user", "built-in"] },
    "SkillInfo": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/SkillName" },
        "description": { "type": "string" },
        "manualOnly": { "type": "boolean" },
        "scope": { "$ref": "#/$defs/SkillScope" }
      },
      "required": ["name", "description", "manualOnly", "scope"]
    },
    "StartConversationRequest": {
      "type": "object",
      "properties": {
        "messages": { "type": "array", "items": { "$ref": "#/$defs/Message" } },
        "workspace": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/ModelId" }
      }
    },
    "StartConversationResponse": {
      "type": "object",
      "properties": { "id": { "$ref": "#/$defs/ModelId" } },
      "required": ["id"]
    },
    "ConversationSummary": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/ModelId" },
        "title": { "type": "string" },
        "session": { "$ref": "#/$defs/SessionId" },
        "running": { "type": "boolean" },
        "startedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "required": ["id", "title", "session", "running", "startedAt"]
    },
    "ConversationsResponse": {
      "type": "object",
      "properties": {
        "conversations": { "type": "array", "items": { "$ref": "#/$defs/ConversationSummary" } }
      },
      "required": ["conversations"]
    },
    "ModelChoice": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/ModelId" },
        "name": { "type": "string" },
        "adapter": { "$ref": "#/$defs/AdapterKind" },
        "model": { "type": "string" }
      },
      "required": ["id", "name", "adapter", "model"]
    },
    "ConversationDetails": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/ModelId" },
        "title": { "type": "string" },
        "session": { "$ref": "#/$defs/SessionId" },
        "running": { "type": "boolean" },
        "startedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "workspace": { "type": "string" },
        "profile": { "$ref": "#/$defs/ModelId" },
        "model": { "$ref": "#/$defs/ModelChoice" },
        "models": { "type": "array", "items": { "$ref": "#/$defs/ModelChoice" } },
        "projectTrust": {
          "type": "string",
          "enum": ["trusted", "untrusted", "changed", "no_hooks"]
        },
        "skipAllowList": { "type": "boolean" }
      },
      "required": [
        "id",
        "title",
        "session",
        "running",
        "startedAt",
        "workspace",
        "profile",
        "model",
        "models",
        "projectTrust",
        "skipAllowList"
      ]
    },
    "SwitchModelRequest": {
      "type": "object",
      "properties": { "id": { "$ref": "#/$defs/ModelId" } },
      "required": ["id"]
    },
    "SendPromptRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "text": { "type": "string", "minLength": 1 } },
          "required": ["text"]
        },
        {
          "type": "object",
          "properties": {
            "parts": { "minItems": 1, "type": "array", "items": { "$ref": "#/$defs/PromptPart" } }
          },
          "required": ["parts"]
        }
      ]
    },
    "StreamQuery": {
      "type": "object",
      "properties": {
        "session": { "$ref": "#/$defs/SessionId" },
        "subtree": { "type": "boolean" },
        "replay": { "type": "boolean" },
        "approvals": { "type": "boolean" }
      }
    },
    "AnswerApprovalRequest": {
      "type": "object",
      "properties": { "response": { "$ref": "#/$defs/ApprovalResponse" } },
      "required": ["response"]
    },
    "MessagesResponse": {
      "type": "object",
      "properties": { "messages": { "type": "array", "items": { "$ref": "#/$defs/Message" } } },
      "required": ["messages"]
    },
    "SkillsResponse": {
      "type": "object",
      "properties": { "skills": { "type": "array", "items": { "$ref": "#/$defs/SkillInfo" } } },
      "required": ["skills"]
    },
    "SkillsQuery": {
      "type": "object",
      "properties": { "search": { "type": "string", "minLength": 1 } }
    },
    "ServerErrorCode": {
      "type": "string",
      "enum": [
        "bad_request",
        "unauthorized",
        "not_found",
        "session_running",
        "unknown_skill",
        "unknown_approval",
        "unknown_model",
        "storage_failed",
        "not_set_up",
        "forbidden",
        "internal"
      ]
    },
    "ServerError": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": { "$ref": "#/$defs/ServerErrorCode" },
            "message": { "type": "string" }
          },
          "required": ["code", "message"]
        }
      },
      "required": ["error"]
    },
    "SessionId": { "type": "string" },
    "CallId": { "type": "string" },
    "TaskId": { "type": "string" },
    "ApprovalId": { "type": "string" },
    "ConversationId": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        { "pattern": "^[0-9a-f-]{36}$" }
      ]
    },
    "StoredConversation": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/ModelId" },
        "title": { "type": "string" },
        "modelId": { "$ref": "#/$defs/ModelId" },
        "workspace": { "type": "string" },
        "profile": { "$ref": "#/$defs/ModelId" },
        "status": { "type": "string", "enum": ["open", "closed", "interrupted"] },
        "startedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "updatedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "required": [
        "id",
        "title",
        "modelId",
        "workspace",
        "profile",
        "status",
        "startedAt",
        "updatedAt"
      ]
    },
    "StoredConversationsQuery": {
      "type": "object",
      "properties": {
        "search": { "type": "string", "minLength": 1 },
        "workspace": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/ModelId" }
      }
    },
    "StoredConversationsResponse": {
      "type": "object",
      "properties": {
        "conversations": { "type": "array", "items": { "$ref": "#/$defs/StoredConversation" } }
      },
      "required": ["conversations"]
    },
    "ModelId": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        { "pattern": "^[0-9a-f-]{36}$" }
      ]
    },
    "AdapterKind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "ModelFile": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/ModelId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "adapter": { "$ref": "#/$defs/AdapterKind" }
      },
      "required": ["id", "name", "adapter"],
      "additionalProperties": {}
    },
    "Model": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/ModelId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "adapter": { "$ref": "#/$defs/AdapterKind" },
        "definition": {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": {}
        }
      },
      "required": ["id", "name", "adapter", "definition"]
    },
    "AdapterDescription": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/AdapterKind" },
        "description": { "type": "string" },
        "config": {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": {}
        },
        "secrets": { "type": "array", "items": { "type": "string" } },
        "remoteField": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "description", "config", "secrets"]
    },
    "KeyCheck": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "status": { "type": "string", "const": "valid" } },
          "required": ["status"]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["invalid", "not_found", "rejected", "unreachable"]
            },
            "message": { "type": "string" }
          },
          "required": ["status", "message"]
        }
      ]
    },
    "CredentialState": { "type": "string", "enum": ["not_needed", "missing", "set"] },
    "SetupModel": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/ModelId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "adapter": { "$ref": "#/$defs/AdapterKind" },
        "definition": {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": {}
        },
        "credential": { "$ref": "#/$defs/CredentialState" },
        "usable": { "type": "boolean" }
      },
      "required": ["id", "name", "adapter", "definition", "credential", "usable"]
    },
    "ProfileSetup": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/ModelId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "lastModelId": { "$ref": "#/$defs/ModelId" },
        "models": { "type": "array", "items": { "$ref": "#/$defs/SetupModel" } },
        "ready": { "type": "boolean" }
      },
      "required": ["id", "name", "models", "ready"]
    },
    "Setup": {
      "type": "object",
      "properties": {
        "home": { "type": "string" },
        "defaultProfile": { "$ref": "#/$defs/ModelId" },
        "profiles": { "type": "array", "items": { "$ref": "#/$defs/ProfileSetup" } },
        "problems": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["home", "profiles", "problems"]
    },
    "AdaptersResponse": {
      "type": "object",
      "properties": {
        "adapters": { "type": "array", "items": { "$ref": "#/$defs/AdapterDescription" } }
      },
      "required": ["adapters"]
    },
    "ModelsQuery": {
      "type": "object",
      "properties": { "search": { "type": "string", "minLength": 1 } }
    },
    "ModelsResponse": {
      "type": "object",
      "properties": { "models": { "type": "array", "items": { "$ref": "#/$defs/SetupModel" } } },
      "required": ["models"]
    },
    "PutProfileRequest": {
      "type": "object",
      "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 80 } },
      "required": ["name"]
    },
    "PutModelRequest": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "adapter": { "$ref": "#/$defs/AdapterKind" },
        "definition": {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": {}
        }
      },
      "required": ["name", "adapter", "definition"]
    },
    "PutCredentialRequest": {
      "type": "object",
      "properties": {
        "secrets": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["secrets"]
    },
    "SetDefaultProfileRequest": {
      "type": "object",
      "properties": { "profile": { "$ref": "#/$defs/ModelId" } },
      "required": ["profile"]
    },
    "WorkspaceRequest": {
      "type": "object",
      "properties": { "workspace": { "type": "string", "minLength": 1 } },
      "required": ["workspace"]
    },
    "BindWorkspaceRequest": {
      "type": "object",
      "properties": {
        "workspace": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/ModelId" }
      },
      "required": ["workspace", "profile"]
    },
    "WorkspaceProfile": {
      "type": "object",
      "properties": {
        "workspace": { "type": "string" },
        "profile": { "$ref": "#/$defs/ModelId" },
        "bound": { "type": "boolean" }
      },
      "required": ["workspace", "bound"]
    },
    "TrustedWorkspace": {
      "type": "object",
      "properties": {
        "root": { "type": "string" },
        "trustedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "state": { "type": "string", "enum": ["trusted", "changed", "gone"] }
      },
      "required": ["root", "trustedAt", "state"]
    },
    "TrustedWorkspacesQuery": {
      "type": "object",
      "properties": { "search": { "type": "string", "minLength": 1 } }
    },
    "TrustedWorkspacesResponse": {
      "type": "object",
      "properties": {
        "workspaces": { "type": "array", "items": { "$ref": "#/$defs/TrustedWorkspace" } }
      },
      "required": ["workspaces"]
    }
  }
}
