{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/require-issue.mjs",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/guard-shell-commands.mjs",
        "timeout": 10,
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/guard-git-workflow.mjs",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/lint-edited-file.mjs",
        "matcher": "Write",
        "timeout": 30
      },
      {
        "command": "node .cursor/hooks/lint-edited-file.mjs",
        "matcher": "Delete",
        "timeout": 30
      },
      {
        "command": "node .cursor/hooks/record-shell-writes.mjs",
        "matcher": "Shell",
        "timeout": 30
      }
    ],
    "postToolUseFailure": [
      {
        "command": "node .cursor/hooks/record-shell-writes.mjs",
        "matcher": "Shell",
        "timeout": 30
      }
    ],
    "subagentStart": [
      {
        "command": "node .cursor/hooks/record-subagent.mjs",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "subagentStop": [
      {
        "command": "node .cursor/hooks/record-subagent-stop.mjs",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/check-on-stop.mjs",
        "timeout": 180,
        "loop_limit": 3
      }
    ]
  }
}
