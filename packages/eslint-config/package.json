{
  "name": "@sheavly/eslint-config",
  "version": "0.0.0",
  "description": "The shared ESLint config and the harness/* rules every workspace is checked with: file kinds, the import graph, public APIs, one definition per type.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/base.js"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.1"
  },
  "peerDependencies": {
    "eslint": "^10.14.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "sheavly": {
    "domain": "tooling"
  }
