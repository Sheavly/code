{
  "name": "@sheavly/providers",
  "version": "0.0.0",
  "description": "Model backends: the Responses protocol, its backends (OpenAI, Azure), the adapter registry and the provider switch. A UI builds its provider here.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    "./registry/default-registry.helper": {
      "@sheavly/source": "./src/registry/default-registry.helper.ts",
      "types": "./dist/registry/default-registry.helper.d.ts",
      "default": "./dist/registry/default-registry.helper.js"
    },
    "./responses/responses.helper": {
      "@sheavly/source": "./src/responses/responses.helper.ts",
      "types": "./dist/responses/responses.helper.d.ts",
      "default": "./dist/responses/responses.helper.js"
    },
    "./switch/switch.service": {
      "@sheavly/source": "./src/switch/switch.service.ts",
      "types": "./dist/switch/switch.service.d.ts",
      "default": "./dist/switch/switch.service.js"
    },
    "./testing/*": {
      "@sheavly/source": "./src/testing/*.ts"
    }
  },
  "dependencies": {
    "@sheavly/core": "^0.0.0",
    "@sheavly/protocol": "^0.0.0",
    "zod": "^4.6.7"
  },
  "private": true,
  "sheavly": {
    "domain": "generic"
  },
  "devDependencies": {
    "@sheavly/testing": "^0.0.0"
  }
}
