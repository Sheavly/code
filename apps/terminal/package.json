{
  "name": "@sheavly/terminal",
  "version": "0.0.0",
  "description": "The terminal front end: the demo (one prompt, printed as it happens) and the workbook (stored prompts, saved runs, step, diff and real-model checks).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts",
    "dev": "tsx --conditions=@sheavly/source src/chat.ts",
    "start": "npm run build && node dist/chat.js",
    "serve": "tsx --conditions=@sheavly/source src/serve.ts"
  },
  "type": "module",
  "license": "UNLICENSED",
  "sheavly": {
    "domain": "coding"
  },
  "private": true,
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@sheavly/coding": "^0.0.0",
    "@sheavly/core": "^0.0.0",
    "@sheavly/host": "^0.0.0",
    "@sheavly/loop": "^0.0.0",
    "@sheavly/protocol": "^0.0.0",
    "@sheavly/providers": "^0.0.0",
    "@sheavly/runtime": "^0.0.0",
    "@sheavly/server": "^0.0.0",
    "@sheavly/tools": "^0.0.0",
    "@sheavly/workspace": "^0.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sheavly/testing": "^0.0.0"
  }
}
