{
  "name": "@sheavly/backend",
  "version": "0.0.0",
  "description": "The harness backend: builds each run from its settings (provider, model, tools, hooks, trust) and serves its conversations to every UI over HTTP.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts",
    "serve": "tsx --conditions=@sheavly/source src/serve.ts"
  },
  "type": "module",
  "license": "Apache-2.0",
  "sheavly": {
    "domain": "coding"
  },
  "private": true,
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "@sheavly/coding": "^0.0.0",
    "@sheavly/core": "^0.0.0",
    "@sheavly/host": "^0.0.0",
    "@sheavly/loop": "^0.0.0",
    "@sheavly/protocol": "^0.0.0",
    "@sheavly/providers": "^0.0.0",
    "@sheavly/runtime": "^0.0.0",
    "@sheavly/storage": "^0.0.0",
    "@sheavly/summary": "^0.0.0",
    "@sheavly/tools": "^0.0.0",
    "@sheavly/workspace": "^0.0.0",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sheavly/client": "^0.0.0",
    "@sheavly/testing": "^0.0.0"
  }
}
