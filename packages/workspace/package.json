{
  "name": "@sheavly/workspace",
  "version": "0.0.0",
  "description": "The project on disk: workspace path confinement, file locks, processes, workspace trust, .sheavly/ project hooks and AGENTS.md.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "type": "module",
  "license": "UNLICENSED",
  "sheavly": {
    "domain": "coding"
  },
  "exports": {
