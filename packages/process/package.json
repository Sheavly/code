{
  "name": "@sheavly/process",
  "version": "0.0.0",
  "description": "The process runner: spawns a command or script without a shell, scrubs secret env, enforces deadlines, and stops what it started when the host exits. Nothing about files or code.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts",
    "prepack": "npm run build"
  },
  "type": "module",
  "license": "Apache-2.0",
  "sheavly": {
    "domain": "generic"
  },
  "private": true,
  "exports": {
    "./*.helper": {
      "@sheavly/source": "./src/*.helper.ts",
      "default": "./dist/*.helper.js"
    },
    "./*.service": {
      "@sheavly/source": "./src/*.service.ts",
      "default": "./dist/*.service.js"
    },
    "./*.types": {
      "@sheavly/source": "./src/*.types.ts",
      "default": "./dist/*.types.js"
    },
    "./*.errors": {
      "@sheavly/source": "./src/*.errors.ts",
      "default": "./dist/*.errors.js"
    },
    "./*.constants": {
      "@sheavly/source": "./src/*.constants.ts",
      "default": "./dist/*.constants.js"
    },
    "./testing/*": {
      "@sheavly/source": "./src/testing/*.ts"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "dependencies": {
    "@sheavly/core": "^0.0.0",
    "@sheavly/runtime": "^0.0.0"
  }
}
