{
  "name": "@sheavly/harness",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "test": "turbo run test test:root",
    "dev": "tsx watch --conditions=@sheavly/source src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "turbo run typecheck typecheck:root",
    "test:watch": "vitest --mode all",
    "lint": "turbo run lint lint:root",
    "lint:fix": "eslint . --fix && prettier --write . --log-level warn",
    "lint:prune": "eslint . --prune-suppressions",
    "check": "turbo run typecheck typecheck:root lint lint:root test test:root format:check knip jscpd layout",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --preprocessor ./scripts/knip-baseline.mjs",
    "knip:baseline": "knip --preprocessor ./scripts/knip-baseline.mjs --no-exit-code",
    "jscpd": "node scripts/jscpd.mjs",
    "jscpd:baseline": "node scripts/jscpd-baseline.mjs",
    "workbook": "tsx --conditions=@sheavly/source src/workbook/workbook.ts",
    "demo": "tsx --conditions=@sheavly/source src/demo.ts",
    "typecheck:root": "tsc --noEmit",
    "lint:root": "eslint . --ignore-pattern 'packages/'",
    "test:root": "vitest run",
    "check:affected": "turbo run typecheck typecheck:root lint lint:root test test:root --affected && turbo run format:check knip jscpd layout",
    "layout": "node scripts/check-layout.mjs"
  },
  "type": "module",
  "dependencies": {
    "@sheavly/core": "^0.0.0",
    "@sheavly/protocol": "^0.0.0",
    "@sheavly/providers": "^0.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sheavly/eslint-config": "^0.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "npm@12.2.1",
  "sheavly": {
    "domain": "coding"
  }
}
