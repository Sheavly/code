{
  "name": "@sheavly/coding",
  "version": "0.0.0",
  "description": "The coding preset: the file tools, run_command and createCodingHarness, on top of the generic harness and the workspace.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "type": "module",
  "license": "UNLICENSED",
  "sheavly": {
    "domain": "coding"
  },
  "exports": {
    "./*": {
      "@sheavly/source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "private": true,
  "dependencies": {
    "@sheavly/core": "^0.0.0",
    "@sheavly/host": "^0.0.0",
    "@sheavly/protocol": "^0.0.0",
    "@sheavly/runtime": "^0.0.0",
    "@sheavly/workspace": "^0.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sheavly/loop": "^0.0.0",
    "@sheavly/testing": "^0.0.0",
    "@sheavly/tools": "^0.0.0"
  }
}
