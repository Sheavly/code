{
  "name": "@sheavly/terminal-ui",
  "version": "0.0.0",
  "description": "Renders a run's events for a terminal: the Renderer the demo and the workbook print with. It writes through a function it is given; it reads no input.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "type": "module",
  "license": "UNLICENSED",
  "sheavly": {
    "domain": "coding"
  },
  "exports": {
    "./*": {
      "@sheavly/source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "private": true,
  "dependencies": {
    "@sheavly/coding": "^0.0.0",
    "@sheavly/core": "^0.0.0",
    "@sheavly/protocol": "^0.0.0",
    "@sheavly/runtime": "^0.0.0",
    "@sheavly/workspace": "^0.0.0",
    "zod": "^4.6.7"
  }
}
