{
  "name": "@sheavly/harness",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch --conditions=@sheavly/source src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write . --log-level warn",
    "lint:prune": "eslint . --prune-suppressions",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run knip && npm run jscpd && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --preprocessor ./scripts/knip-baseline.mjs",
    "knip:baseline": "knip --preprocessor ./scripts/knip-baseline.mjs --no-exit-code",
    "jscpd": "node scripts/jscpd.mjs",
    "jscpd:baseline": "node scripts/jscpd-baseline.mjs",
    "workbook": "tsx --conditions=@sheavly/source src/workbook/workbook.ts",
    "demo": "tsx --conditions=@sheavly/source src/demo.ts"
  },
  "type": "module",
  "dependencies": {
    "@sheavly/core": "^0.0.0",
    "@sheavly/providers": "^0.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sheavly/eslint-config": "^0.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ]
}
