      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "private": true,
  "dependencies": {
    "@sheavly/core": "^0.0.0",
    "@sheavly/runtime": "^0.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sheavly/loop": "^0.0.0",
    "@sheavly/testing": "^0.0.0"
  }
