{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The Cursor hooks: plain Node scripts with no build and no type errors to check (`checkJs`
    // stays off). The project exists so ESLint has type info for them, which `no-deprecated` needs.
    "allowJs": true,
    "noEmit": true
  },
  "include": ["."]
}
