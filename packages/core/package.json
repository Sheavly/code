{
  "name": "@sheavly/core",
  "version": "0.0.0",
  "description": "The code contracts tools, hooks and providers are written against: defineTool, defineHook, defineAdapter, Provider and the Environment an app passes in.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "exports": {
    "./adapter/adapter.types": {
      "@sheavly/source": "./src/adapter/adapter.types.ts",
      "types": "./dist/adapter/adapter.types.d.ts",
      "default": "./dist/adapter/adapter.types.js"
    },
    "./adapter/adapter.utils": {
      "@sheavly/source": "./src/adapter/adapter.utils.ts",
      "types": "./dist/adapter/adapter.utils.d.ts",
      "default": "./dist/adapter/adapter.utils.js"
    },
    "./environment/environment.types": {
      "@sheavly/source": "./src/environment/environment.types.ts",
      "types": "./dist/environment/environment.types.d.ts",
      "default": "./dist/environment/environment.types.js"
    },
    "./errors/tool.errors": {
      "@sheavly/source": "./src/errors/tool.errors.ts",
      "types": "./dist/errors/tool.errors.d.ts",
      "default": "./dist/errors/tool.errors.js"
    },
    "./hook/hook.types": {
      "@sheavly/source": "./src/hook/hook.types.ts",
      "types": "./dist/hook/hook.types.d.ts",
      "default": "./dist/hook/hook.types.js"
    },
    "./hook/hook.utils": {
      "@sheavly/source": "./src/hook/hook.utils.ts",
      "types": "./dist/hook/hook.utils.d.ts",
      "default": "./dist/hook/hook.utils.js"
    },
    "./message/message.types": {
      "@sheavly/source": "./src/message/message.types.ts",
      "types": "./dist/message/message.types.d.ts",
      "default": "./dist/message/message.types.js"
    },
    "./provider/provider.types": {
      "@sheavly/source": "./src/provider/provider.types.ts",
      "types": "./dist/provider/provider.types.d.ts",
      "default": "./dist/provider/provider.types.js"
    },
    "./tool/tool.helper": {
      "@sheavly/source": "./src/tool/tool.helper.ts",
      "types": "./dist/tool/tool.helper.d.ts",
      "default": "./dist/tool/tool.helper.js"
    },
    "./tool/tool.types": {
      "@sheavly/source": "./src/tool/tool.types.ts",
      "types": "./dist/tool/tool.types.d.ts",
      "default": "./dist/tool/tool.types.js"
    },
    "./tool/tool.utils": {
      "@sheavly/source": "./src/tool/tool.utils.ts",
      "types": "./dist/tool/tool.utils.d.ts",
      "default": "./dist/tool/tool.utils.js"
    },
    "./tool/tool.validator": {
      "@sheavly/source": "./src/tool/tool.validator.ts",
      "types": "./dist/tool/tool.validator.d.ts",
      "default": "./dist/tool/tool.validator.js"
    },
    "./validation/validation.validator": {
      "@sheavly/source": "./src/validation/validation.validator.ts",
      "types": "./dist/validation/validation.validator.d.ts",
      "default": "./dist/validation/validation.validator.js"
    }
  },
  "dependencies": {
    "@sheavly/protocol": "^0.0.0",
    "zod": "^4.6.7"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "sheavly": {
    "domain": "generic"
  }
}
