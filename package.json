{
  "name": "@sheavly/harness",
  "version": "1.0.0",
  "scripts": {
    "test": "turbo run test test:root",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test:watch": "vitest --mode all",
    "lint": "turbo run lint lint:root",
    "lint:fix": "eslint . --fix && prettier --write . --log-level warn",
    "check": "turbo run typecheck lint lint:root test test:root format:check knip jscpd layout",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "jscpd": "node scripts/jscpd.mjs",
    "workbook": "tsx --conditions=@sheavly/source apps/workbook/src/workbook/workbook.ts",
    "demo": "tsx --conditions=@sheavly/source apps/terminal/src/demo.ts",
    "lint:root": "eslint . --ignore-pattern 'packages/' --ignore-pattern 'apps/'",
    "test:root": "vitest run",
    "check:affected": "turbo run typecheck lint lint:root test test:root --affected && turbo run format:check knip jscpd layout",
    "layout": "node scripts/check-layout.mjs",
    "new": "node scripts/new-workspace.mjs",
    "graph": "node scripts/graph.mjs",
    "export": "node scripts/export.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@sheavly/eslint-config": "^0.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "npm@12.2.1"
}
