{
  "name": "@sheavly/server",
  "version": "0.0.0",
  "description": "The harness over HTTP: Hono routes that serve a host's conversations to UIs in other processes, with SSE streams and a typed client. Only apps depend on it.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts",
    "prepack": "npm run build"
  },
  "type": "module",
  "license": "UNLICENSED",
  "sheavly": {
    "domain": "generic",
    "transport": true
  },
  "private": true,
  "exports": {
    "./*.helper": {
      "@sheavly/source": "./src/*.helper.ts",
      "default": "./dist/*.helper.js"
    },
    "./*.types": {
      "@sheavly/source": "./src/*.types.ts",
      "default": "./dist/*.types.js"
    },
    "./testing/*": {
      "@sheavly/source": "./src/testing/*.ts"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@sheavly/host": "^0.0.0",
    "@sheavly/protocol": "^0.0.0",
    "@sheavly/runtime": "^0.0.0",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.6",
    "@sheavly/core": "^0.0.0",
    "@sheavly/loop": "^0.0.0",
    "@sheavly/testing": "^0.0.0"
  }
}
