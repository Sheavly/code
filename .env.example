# What the processes read from the environment (see apps/backend/docs/serve.md).
#
# Models and keys are NOT here: they are the user's, in ~/.sheavly (see README.md).

# Directory file tools are confined to (default: current directory)
# WORKSPACE_ROOT=

# Public web reading for main and sub-agents (default: true). The terminal passes this to its backend.
# WEB_FETCH=true

# The user's folder: profiles, models, keys, conversations and trusted workspaces
# (default: .sheavly in your home folder)
# SHEAVLY_HOME=

# How a model call is sent: how long to wait for a response to start, and how many times to
# retry one that failed before anything streamed (first wait in ms, doubled each time).
# MODEL_RESPONSE_TIMEOUT_MS=60000
# MODEL_RETRIES=2
# MODEL_RETRY_DELAY_MS=1000
