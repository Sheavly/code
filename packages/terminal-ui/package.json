{
  "name": "@sheavly/terminal-ui",
  "version": "0.0.0",
  "description": "Renders a run's events for a terminal: the Renderer the demo and the workbook print with. It writes through a function it is given; it reads no input.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "type": "module",
  "license": "UNLICENSED",
  "sheavly": {
    "domain": "coding"
  },
  "exports": {
    "./render/render.constants": {
      "@sheavly/source": "./src/render/render.constants.ts",
      "types": "./dist/render/render.constants.d.ts",
      "default": "./dist/render/render.constants.js"
    },
    "./render/render.service": {
      "@sheavly/source": "./src/render/render.service.ts",
      "types": "./dist/render/render.service.d.ts",
      "default": "./dist/render/render.service.js"
    },
    "./render/render.types": {
      "@sheavly/source": "./src/render/render.types.ts",
      "types": "./dist/render/render.types.d.ts",
      "default": "./dist/render/render.types.js"
    },
    "./render/render.utils": {
      "@sheavly/source": "./src/render/render.utils.ts",
      "types": "./dist/render/render.utils.d.ts",
      "default": "./dist/render/render.utils.js"
    }
  },
  "private": true,
  "dependencies": {
    "@sheavly/coding": "^0.0.0",
    "@sheavly/core": "^0.0.0",
    "@sheavly/protocol": "^0.0.0",
    "@sheavly/runtime": "^0.0.0",
    "@sheavly/workspace": "^0.0.0",
    "zod": "^4.6.7"
  }
}
