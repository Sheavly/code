{
  "$schema": "../../packages/extension/sheavly.schema.json",
  "name": "coding",
  "dependsOn": ["agents"],
  "services": {
    "requires": ["sub-agents", "session-info", "background-tasks", "approvals", "main-session"],
    "optional": ["output-capture"],
    "provides": ["coding-run"]
  },
  "grants": [
    "output:capture",
    "session:read",
    "task:start",
    "approval:request",
    "approval:as-tool",
    "approval:keep",
    "system-prompt:extend",
    "sub-agent:share"
  ],
  "tools": [
    "read_file",
    "glob",
    "grep",
    "write_file",
    "edit_file",
    "delete_file",
    "set_working_root",
    "read_skill",
    "run_command",
    "start_service"
  ],
  "hooks": ["agents-md", "skills", "scratch", "working-root", "*"],
  "instructions": ["coding"]
}
