{
  "name": "@sheavly/loop",
  "version": "0.0.0",
  "description": "The agent loop: streamAgent and runAgent, its events, the ordered queue, aborts and hooks. Generic: no project on disk.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "type": "module",
  "license": "UNLICENSED",
  "sheavly": {
    "domain": "generic"
  },
  "exports": {
    "./stream-agent/stream-agent.helper": {
      "@sheavly/source": "./src/stream-agent/stream-agent.helper.ts",
      "types": "./dist/stream-agent/stream-agent.helper.d.ts",
      "default": "./dist/stream-agent/stream-agent.helper.js"
    }
  },
  "private": true,
  "dependencies": {
    "@sheavly/core": "^0.0.0",
    "@sheavly/protocol": "^0.0.0",
    "@sheavly/runtime": "^0.0.0"
  },
  "devDependencies": {
    "@sheavly/testing": "^0.0.0",
    "@sheavly/tools": "^0.0.0",
    "zod": "^4.6.7"
  }
}
